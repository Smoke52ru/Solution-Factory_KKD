# Шаблон: переменные ${...} подставляет envsubst из entrypoint образа nginx.
# Переменные nginx ($uri и т. п.) не затрагиваются — подставляются только
# переменные, заданные в окружении контейнера.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # mock API: /api/* и /health уходят на бэкенд как есть, без изменения пути
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
    }

    # Хешированные файлы сборки можно кешировать надолго
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html не кешируем, чтобы новая сборка подхватывалась сразу
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback: любой неизвестный путь отдаёт index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
