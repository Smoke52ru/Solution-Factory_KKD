# --- Фронтенд ---------------------------------------------------------------

# Базовый URL API. Пусто — относительные пути `/api` (в dev их проксирует Vite,
# в Docker — nginx). Значение читается при сборке (`import.meta.env`),
# в компонентах адрес не хардкодится. Пример: http://localhost:8000
VITE_API_URL=

# Куда Vite проксирует /api и /health в режиме разработки (`npm run dev`)
VITE_API_PROXY_TARGET=http://localhost:8000

# --- Docker (docker compose up) ---------------------------------------------

# Куда nginx проксирует /api и /health. Читается при старте контейнера frontend,
# по умолчанию — сервис backend из docker-compose.yml.
API_UPSTREAM=http://backend:8000
